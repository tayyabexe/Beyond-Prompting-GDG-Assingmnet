        </mxCell>
        <mxCell id="sauth" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;admin user · issues JWT&lt;br&gt;public sign-ups disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="supa">
