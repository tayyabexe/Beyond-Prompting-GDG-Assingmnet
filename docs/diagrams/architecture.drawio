  <diagram id="erd" name="Database ERD">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t0" value="NEXUS-COMMERCE — Database ERD (Supabase Postgres)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <mxCell id="customers" value="&lt;b&gt;customers&lt;/b&gt;&lt;hr&gt;🔑 id uuid&lt;br&gt;name text&lt;br&gt;email text UNIQUE&lt;br&gt;phone text&lt;br&gt;city text&lt;br&gt;created_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;hr&gt;🔑 id text ('NX-1001')&lt;br&gt;🔗 customer_id uuid&lt;br&gt;ship_name, ship_email, ship_phone&lt;br&gt;ship_address, ship_city&lt;br&gt;payment text (cod | demo)&lt;br&gt;subtotal int · shipping int · total int&lt;br&gt;status text (pending | processing |&lt;br&gt;&amp;nbsp;shipped | delivered | cancelled)&lt;br&gt;created_at · updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="items" value="&lt;b&gt;order_items&lt;/b&gt;&lt;hr&gt;🔑 id bigint&lt;br&gt;🔗 order_id text&lt;br&gt;🔗 product_id text&lt;br&gt;product_name text (snapshot)&lt;br&gt;unit_price int (snapshot)&lt;br&gt;qty int (&amp;gt; 0)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="products" value="&lt;b&gt;products&lt;/b&gt;&lt;hr&gt;🔑 id text (slug)&lt;br&gt;name text&lt;br&gt;category text&lt;br&gt;description text&lt;br&gt;price int (&amp;gt; 0)&lt;br&gt;stock int (&amp;gt;= 0)&lt;br&gt;image_url · image_credit&lt;br&gt;featured bool&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="120" width="230" height="210" as="geometry" />
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;order_status_history&lt;/b&gt;&lt;hr&gt;🔑 id bigint&lt;br&gt;🔗 order_id text&lt;br&gt;status text&lt;br&gt;changed_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="450" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="inquiries" value="&lt;b&gt;inquiries&lt;/b&gt;&lt;hr&gt;🔑 id text ('INQ-1001')&lt;br&gt;name · email&lt;br&gt;subject · message&lt;br&gt;🔗 product_id text (nullable)&lt;br&gt;status text (open | in_progress | resolved)&lt;br&gt;created_at · updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="450" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;inquiry_notes&lt;/b&gt;&lt;hr&gt;🔑 id bigint&lt;br&gt;🔗 inquiry_id text&lt;br&gt;note text&lt;br&gt;created_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="780" y="470" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="places" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmany;startArrow=ERmandOne;html=1;endFill=0;startFill=0;" edge="1" parent="1" source="customers" target="orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="contains" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmany;startArrow=ERmandOne;html=1;endFill=0;startFill=0;" edge="1" parent="1" source="orders" target="items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="sold as" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmany;startArrow=ERmandOne;html=1;endFill=0;startFill=0;" edge="1" parent="1" source="products" target="items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="status log" style="endArrow=ERmany;startArrow=ERmandOne;html=1;endFill=0;startFill=0;" edge="1" parent="1" source="orders" target="history">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="asked about (optional)" style="endArrow=ERmany;startArrow=ERzeroToOne;html=1;endFill=0;startFill=0;" edge="1" parent="1" source="products" target="inquiries">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="has" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmany;startArrow=ERmandOne;html=1;endFill=0;startFill=0;" edge="1" parent="1" source="inquiries" target="notes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fn" value="&lt;b&gt;Database functions&lt;/b&gt;&lt;br&gt;place_order(customer, items, payment) → order id&lt;br&gt;&amp;nbsp;&amp;nbsp;locks product rows, checks + reduces stock, upserts customer,&lt;br&gt;&amp;nbsp;&amp;nbsp;computes totals from DB prices, writes order + items + history&lt;br&gt;update_order_status(order_id, new_status)&lt;br&gt;&amp;nbsp;&amp;nbsp;validates transition, restocks on cancel, writes history&lt;br&gt;&lt;br&gt;&lt;b&gt;RLS&lt;/b&gt;: enabled on every table, no public policies (backend uses service key)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#cccccc;rounded=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="560" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
